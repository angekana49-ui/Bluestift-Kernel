# Bluestift Cognitive Kernel — environment template.
#
# Copy to .env and fill in. `.env` is gitignored; THIS file is tracked, because
# it is the only list of what a deployment needs. Never put a real value here.
#
# On Railway/Render these are set in the dashboard, not from a file.

# --- Database (required) --------------------------------------------------- #
# The Supabase project the Kernel shares with the RAYA app.
# SERVICE_KEY is the service_role key — never the anon key, and never shipped
# to a browser. It bypasses RLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# --- LLM chain (required) -------------------------------------------------- #
# Primary: Groq (openai/gpt-oss-120b). Fallback: Gemini (gemini-3.1-flash-lite).
# The chain only fails /analyze if BOTH are unavailable, so set both in
# production — a single provider means a rate limit takes the Kernel down.
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Auth (required in production) ----------------------------------------- #
# Shared secret for the protected routes (/analyze, /load_profile,
# /update_concept_state, /seed_kcs). /health and /ready stay open.
# MUST match KERNEL_API_SECRET in the RAYA app's .env.local.
# Leave EMPTY to disable auth entirely — local development only.
KERNEL_API_SECRET=

# --- Optional -------------------------------------------------------------- #
# Reported by /health and /ready. Defaults to 1.0.0.
KERNEL_VERSION=1.0.0

# Comma-separated CORS origins. Defaults to the RAYA + schools domains plus
# http://localhost:3000, which is usually what you want.
# CORS_ORIGINS=https://raya.thebluestift.com,http://localhost:3000

# --- Migrations only ------------------------------------------------------- #
# A Supabase personal access token (sbp_...), used ONLY by
# scripts/apply_migrations.py to push SQL through the Management API.
# Not needed by the running service — leave it out of the deployment env.
SUPABASE_ACCESS_TOKEN=
